# Every value below is read by config.py. A real environment variable always
# wins over this file. Malformed values fail startup instead of being ignored.

# --- Required ---

# Discord Bot Token (Get from https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Comma-separated Discord user IDs allowed to use the bot at all.
# REQUIRED while tools are enabled: the agent can run shell commands on the
# host, so there is no safe default. Startup fails if this is empty.
# DMs and mentions are routing signals, not identity - they do not bypass this.
DISCORD_ALLOWED_USER_IDS=111111111111111111,222222222222222222

# --- Optional ---

# Comma-separated subset of the above allowed to purge channel messages.
# Every admin must also appear in DISCORD_ALLOWED_USER_IDS.
# DISCORD_ADMIN_USER_IDS=222222222222222222

# Comma-separated Channel IDs where the bot responds without needing @mentions
# DISCORD_FREE_RESPONSE_CHANNELS=123456789012345678,987654321098765432

# OpenAI-compatible LLM Server URL (e.g. rapid-mlx, vLLM, Ollama, llama.cpp)
LLM_BASE_URL=http://127.0.0.1:18080/v1
MODEL_NAME=default

# Set true to allow a non-local LLM_BASE_URL. Conversation content and tool
# results leave the machine, so this needs an explicit decision.
# LLM_ALLOW_REMOTE=false

# Sent as the API key. Local servers ignore it; remote endpoints usually need it.
# LLM_API_KEY=

# Independent wait budgets in seconds. A 400 recovery retry shares the original
# MODEL_STAGE_TIMEOUT_SECONDS budget instead of starting a second full budget.
LLM_CONNECT_TIMEOUT_SECONDS=15
LLM_IDLE_TIMEOUT_SECONDS=120
MODEL_STAGE_TIMEOUT_SECONDS=600
TOOL_STAGE_TIMEOUT_SECONDS=120
BASH_TIMEOUT_SECONDS=60

# Log hygiene. A run log rotates past LOG_MAX_BYTES keeping one previous
# generation; startup deletes run logs and inactive run workspaces older than
# LOG_RETENTION_DAYS.
LOG_MAX_BYTES=1048576
LOG_RETENTION_DAYS=14

# Set true to store raw reasoning, tool arguments, and tool results under
# SYSTEM_LOG_DIR/content-debug/. This is the one setting that puts content back
# on disk, so it is off unless an operator explicitly decides otherwise.
LOG_CONTENT_DEBUG=false
LOG_CONTENT_DEBUG_RETENTION_HOURS=24

# Set false to run without tools. Then DISCORD_ALLOWED_USER_IDS is not required.
# BOT_TOOLS_ENABLED=true

# Custom workspace & log directories
# WORKSPACE_DIR=./workspace
# SYSTEM_LOG_DIR=./.system_logs
